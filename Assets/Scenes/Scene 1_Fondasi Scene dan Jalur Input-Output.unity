  m_text: "<b><color=#FFD700><size=115%>GALERI PENGENALAN KAMPUS</size></color></b>\n<size=78%><color=#8FA0B5>Gedung
    Rektorat UPN \u201CVeteran\u201D Jakarta (Sub-CPMK 1)</color></size>\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n<b>Objek
